{
  "name": "shipping-service",
  "version": "1.0.1",
  "description": "Shipping consumer for Pact PoC",
  "main": "src/ordersClient.js",
  "scripts": {
    "pact:test": "vitest run --project=pact",
    "pact:publish": "pact-broker publish ./pacts --consumer-app-version=$npm_package_version --broker-base-url=${PACT_BROKER_BASE_URL:-http://localhost:9292} --broker-username=${PACT_BROKER_USERNAME:-pact} --broker-password=${PACT_BROKER_PASSWORD:-pact}"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.26.9",
    "@pact-foundation/pact": "^16.0.4",
    "@pact-foundation/pact-cli": "^16.0.4",
    "vitest": "^4.1.8"
  }
}
